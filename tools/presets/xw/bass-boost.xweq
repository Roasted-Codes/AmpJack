# BASS BOOST: more thump for music, films and fun, not for competition. None of the
# other presets puts the bass above the middle (on this headset they all lean bright).
#
# The .xweq format (this project's own presets; convert.py read_xweq): INI. [General] Author
# (the credit stored in the file) and Level (match: as loud as every other preset, the
# preamp is chosen for it; own: not loudness-matched, for a band-pass that cannot be made as
# loud without going over 0 dB). Then up to 5 [Band_N] sections, Type: lowshelf, highshelf
# (Freq = the half-gain point, Slope 1 = the gentlest RBJ shelf without overshoot), peak (Q:
# 0.7 is about two octaves wide, 1.4 one octave), highpass, lowpass (Q 0.707 = Butterworth).
# Gains in dB, any value (not limited to the Astro's whole dB). To try a change: edit a
# number, run python3 tools/presets/convert.py, then python3 xbox360/eq.py install.
[General]
Author = Xbox360-GIP
Level = match

[Band_1]
Type = lowshelf
Freq = 120
Gain = 6
Slope = 1

# Keeps the boost from turning into mud.
[Band_2]
Type = peak
Freq = 400
Gain = -1
Q = 1.0
